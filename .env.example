PORT=3000
NODE_ENV=production
# Public URL of the Node-hosted storefront (no trailing slash).
PUBLIC_ORIGIN=https://your-store.example
DATABASE_PATH=./var/store.sqlite
# Keep false until catalog, stock, policies and gateway setup are reviewed.
STORE_ENABLED=false
# First verify checkout with Razorpay TEST keys; never commit real keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ORDER_ACCESS_SECRET=
# Optional if GitHub Pages fronts your Node backend. Exact origin, no wildcard.
STOREFRONT_ORIGIN=

# Set to 1 only behind one trusted reverse proxy that appends/overwrites X-Forwarded-For.
TRUST_PROXY_HOPS=0

# Optional HTTPS Nominatim-compatible provider; default is the public OSM service.
GEOCODER_URL=https://nominatim.openstreetmap.org/

# Automatic seller alerts. Leave blank until a sending provider is configured.
# Use email first, or comma-separated email,sms,whatsapp for all three.
SELLER_NOTIFICATION_CHANNELS=
# Gmail: enable 2-Step Verification and generate an App Password.
# Never use the normal Gmail password or put this secret in frontend code.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=sdhanpal778@gmail.com
SMTP_FROM=sdhanpal778@gmail.com
SMTP_PASS=
# Optional Twilio channels; registered senders are separate from the seller recipient.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=
